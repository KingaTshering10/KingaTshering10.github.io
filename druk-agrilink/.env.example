# DrukAgriLink environment configuration — PLACEHOLDERS ONLY.
# Copy to .env and fill in real values. Never commit .env.

# --- API ---
DRUK_ENVIRONMENT=development            # development | test | staging | production
DRUK_DEBUG=false
DRUK_DATABASE_URL=postgresql+psycopg://druk:CHANGE_ME@db:5432/drukagrilink
DRUK_JWT_SECRET=CHANGE_ME_LONG_RANDOM   # e.g. `openssl rand -hex 32`
DRUK_ACCESS_TOKEN_MINUTES=30
DRUK_REFRESH_TOKEN_DAYS=14
DRUK_CORS_ORIGINS=http://localhost:3000
DRUK_REDIS_URL=redis://redis:6379/0     # optional; empty = in-process fallback
DRUK_SEED_DEMO_ACCOUNTS=true            # MUST be false in production

# --- Business parameters (admin-adjustable defaults) ---
DRUK_PLATFORM_FEE_PERCENT=2.0
DRUK_DELIVERY_DISCREPANCY_TOLERANCE_PERCENT=2.0
DRUK_ROAD_CIRCUITY_FACTOR=1.6
DRUK_AVERAGE_SPEED_KMH=35
DRUK_TRANSPORT_COST_PER_KM_NU=45

# --- Postgres container ---
POSTGRES_USER=druk
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=drukagrilink

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
